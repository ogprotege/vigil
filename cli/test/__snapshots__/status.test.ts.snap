// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`doctor > reports discovery results without any network calls (golden) 1`] = `
"Claude
  ✓ credentials found (file)
  access token valid ~119m
  refresh token: present
  plan: max

ChatGPT / Codex
  ✓ credentials found (file)
  access token valid ~26h
  account id: present
  plan: pro

vigil-link is stateless: it never writes credentials to disk (ADR-0004).
"
`;

