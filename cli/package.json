{
  "name": "vigil-link",
  "version": "0.2.0",
  "description": "Link supported AI provider accounts to Vigil and check subscription usage, credits, and balances from the terminal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogprotege/vigil.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/ogprotege/vigil#readme",
  "bugs": {
    "url": "https://github.com/ogprotege/vigil/issues"
  },
  "type": "module",
  "bin": {
    "vigil-link": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-spec.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen-vectors": "npm run build && node scripts/gen-vectors.mjs"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
